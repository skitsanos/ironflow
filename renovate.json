{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": ["develop"],
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["dtolnay/rust-toolchain@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["rust-version"],
      "matchPackageNames": ["rust"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "AWS SDK crates share one smithy runtime and must move in lockstep, so every aws-* crate updates in a single grouped PR.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^aws-/"],
      "groupName": "AWS SDK"
    },
    {
      "description": "Defer PR #182's incompatible AWS cohort: https://github.com/smithy-lang/smithy-rs/issues/4853. Later releases remain eligible.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["aws-sdk-s3"],
      "allowedVersions": "!/^1\\.147\\.0$/"
    },
    {
      "description": "Defer PR #182's incompatible AWS cohort: https://github.com/smithy-lang/smithy-rs/issues/4853. Later releases remain eligible.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["aws-sdk-s3vectors"],
      "allowedVersions": "!/^1\\.37\\.0$/"
    },
    {
      "description": "Defer PR #182's incompatible AWS cohort: https://github.com/smithy-lang/smithy-rs/issues/4853. Later releases remain eligible.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["aws-smithy-types"],
      "allowedVersions": "!/^1\\.7\\.0$/"
    }
  ]
}
