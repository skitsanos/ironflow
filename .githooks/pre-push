#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

develop_local=""
develop_remote=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/develop" && ! "$local_sha" =~ ^0+$ ]]; then
    develop_local=$local_sha
    develop_remote=$remote_sha
  fi
done

if [[ -z "$develop_local" ]]; then
  exit 0
fi

echo "IronFlow develop pre-push: checking incoming pull requests"
bun run scripts/check_incoming_prs.ts

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Push blocked: the worktree must be clean so the integration gate tests exactly what will be pushed." >&2
  exit 1
fi

if [[ ! "$develop_remote" =~ ^0+$ ]]; then
  if ! git cat-file -e "$develop_remote^{commit}" 2>/dev/null; then
    echo "Push blocked: the remote develop commit is not available locally; fetch and integrate it first." >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$develop_remote" "$develop_local"; then
    echo "Push blocked: remote develop is not an ancestor of the commit being pushed; fetch and integrate it first." >&2
    exit 1
  fi
fi

echo "IronFlow develop pre-push: checking committed development version"
bun run scripts/development_version.ts check "$develop_local" "$develop_remote"

# The full gate cannot run inside the push: GitHub closes the idle SSH session
# long before scripts/integration_gate.sh finishes (IF-172). A passing gate
# records a receipt for the tree it validated, and the default mode accepts
# only a fresh receipt for the commit being pushed. IRONFLOW_PREPUSH_GATE=fast
# keeps an intermediate develop push honest but quick: formatting, repository
# policy, default Clippy and the example and CLI binaries. The full gate stays
# mandatory before merging a release branch or cutting a release.
case "${IRONFLOW_PREPUSH_GATE:-full}" in
  full)
    echo "IronFlow develop pre-push: checking the integration gate receipt for the pushed commit"
    bun --no-env-file scripts/gate_receipt.ts check "$develop_local"
    ;;
  fast)
    echo "IronFlow develop pre-push: IRONFLOW_PREPUSH_GATE=fast; run scripts/integration_gate.sh before merging or releasing"
    cargo fmt --all -- --check
    bun run scripts/issues_registry.ts check
    bun test scripts/tests/*.test.ts
    cargo clippy --all-targets -- -D warnings
    bun --no-env-file scripts/test_rust_targets.ts --test examples --test cli
    ;;
  *)
    echo "Push blocked: IRONFLOW_PREPUSH_GATE must be 'full' or 'fast'." >&2
    exit 1
    ;;
esac
